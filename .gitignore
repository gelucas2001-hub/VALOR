# Herramientas locales
# Git no puede re-incluir un archivo si su directorio padre esta
# excluido, asi que `.claude/` + `!.claude/skills/**` NO trackeaba las
# skills: dejo afuera a `valor-analisis-estadisticas` en silencio.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/valor-analisis-inclinacion/
!.claude/skills/valor-analisis-estadisticas/
.impeccable/

# Python
__pycache__/
*.pyc
.superpowers/
data/_snapshot_antes.json
.github/skills/
skills-lock.json
.agents/

# Cache de football-data.co.uk: es de dominio publico, se re-baja
# solo, y crece con cada fecha. No tiene sentido versionarlo.
data/cache_historico/
scratch/
